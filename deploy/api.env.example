# Copy to /root/livelifetricks-api.env and fill in. Never commit the real file.
PORT=3077
DATA_DIR=/var/lib/llt-api
ADMIN_PASSWORD=change-this-to-a-long-password
SESSION_SECRET=paste-a-long-random-string-here
BIODATA_PRICE=20
INVITE_PRICE=29
# Razorpay: Dashboard > Account & Settings > API Keys (use rzp_test_ keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, recommended: Dashboard > Webhooks > URL https://livelifetricks.com/api/biodata/webhook, events payment.captured
RAZORPAY_WEBHOOK_SECRET=
